    {
      "parameters": {
        "jsCode": "const data = $input.first().json.body.Data;\nconst email = data.Buyer.Email.toLowerCase().trim();\nconst fullName = data.Buyer.Name || '';\nconst firstName = fullName.split(' ')[0];\nconst offerName = data.Offer?.Name || '';\n// Quem compra o Método ganha o Margem Certa por 1 ano\nconst produtos = (data.Products || []).map((p) => (p.Name || '').toLowerCase()).join(' ');\nconst doMetodo = produtos.includes('método') || produtos.includes('metodo') || produtos.includes('loja online lucrativa');\nconst isAnual = doMetodo || offerName.toLowerCase().includes('anual') || offerName.includes('97');\nconst now = new Date();\nconst expiresAt = new Date(now);\nif (isAnual) {\n  expiresAt.setFullYear(expiresAt.getFullYear() + 1);\n} else {\n  expiresAt.setMonth(expiresAt.getMonth() + 1);\n}\nreturn [{\n  json: {\n    email,\n    first_name: firstName,\n    plan_type: isAnual ? 'annual' : 'monthly',\n    expires_at: expiresAt.toISOString(),\n    status: 'active',\n    is_admin: false\n  }\n}];"
      },
      "name": "Preparar dados",
