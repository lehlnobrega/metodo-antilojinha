    {
      "parameters": {
        "jsCode": "// Reembolso do Método: só fecha o Margem Certa se o acesso dela lá veio do Método\n// (se ela comprou o Margem Certa à parte e o plano vai mais longe, não mexe).\nconst d = $('Conferir e preparar').first().json;\nconst u = $input.first().json || {};\nconst existe = Boolean(u && u.email);\nconst limite = new Date(d.acesso_ate);\nlimite.setDate(limite.getDate() + 3);\nconst veioDoMetodo = existe && (!u.expires_at || new Date(u.expires_at) <= limite);\nreturn [{ json: { email: d.email, fechar: veioDoMetodo } }];"
