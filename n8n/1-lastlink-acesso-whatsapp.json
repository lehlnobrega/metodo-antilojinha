      "parameters": {
        "jsCode": "// Margem Certa: o acesso vai até o fim do ano do Método.\n// Se ela já tinha um plano próprio do Margem Certa que vai mais longe, mantém a data maior.\nconst d = $('Conferir e preparar').first().json;\nconst u = $input.first().json || {};\nconst existe = Boolean(u && u.email);\nlet expira = d.acesso_ate;\nif (existe && u.expires_at && new Date(u.expires_at) > new Date(expira)) expira = new Date(u.expires_at).toISOString();\nreturn [{ json: { email: d.email, first_name: d.primeiro_nome, expires_at: expira, existe } }];"
