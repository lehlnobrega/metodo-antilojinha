{
  "name": "Método | Lastlink libera acesso + WhatsApp + Margem Certa",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "metodo-lastlink",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Lastlink (webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1100,
        300
      ],
      "id": "f2a6ca68-74b5-4017-9b96-91640476afa6",
      "webhookId": "afe65b82-3f5e-4691-a82e-2c5ef68e9191"
    },
    {
      "parameters": {
        "jsCode": "// ===================== CONFIGURAÇÃO (preencha uma vez) =====================\n// Token que a Lastlink mostra na tela do webhook do Método (chega no cabeçalho x-lastlink-token)\nconst TOKEN_LASTLINK = 'COLE_AQUI_O_TOKEN_DA_LASTLINK';\n// Parte do nome do produto na Lastlink. Deixe '' pra aceitar tudo o que chegar neste webhook.\nconst PRODUTO_CONTEM = '';\n// ===========================================================================\nconst SUPABASE_URL = 'https://ivfgpircfwwgpumrrcwp.supabase.co';\nif (TOKEN_LASTLINK.includes('COLE_AQUI')) throw new Error('Preencha o TOKEN_LASTLINK no topo do nó \"Conferir e preparar\".');\n\nconst req = $input.first().json;\nconst token = (req.headers && req.headers['x-lastlink-token']) || '';\nif (token !== TOKEN_LASTLINK) throw new Error('Token da Lastlink não confere. Pedido ignorado por segurança.');\n\nconst body = req.body || {};\nconst data = body.Data || {};\nconst buyer = data.Buyer || {};\nconst purchase = data.Purchase || {};\nconst evento = body.Event || '';\nconst email = String(buyer.Email || '').toLowerCase().trim();\nif (!email) throw new Error('A Lastlink mandou um evento sem e-mail.');\n\nconst produtos = (data.Products || []).map((p) => p.Name).filter(Boolean).join(', ');\nconst LIBERAR = ['Purchase_Order_Confirmed', 'Recurrent_Payment'];\nconst BLOQUEAR = { Payment_Refund: 'reembolsada', Payment_Chargeback: 'cancelada' };\nlet acao = 'ignorar';\nif (LIBERAR.includes(evento)) acao = 'liberar';\nelse if (BLOQUEAR[evento]) acao = 'bloquear';\nif (PRODUTO_CONTEM && !produtos.toLowerCase().includes(PRODUTO_CONTEM.toLowerCase())) acao = 'ignorar';\n\n// A Lastlink manda a data sem fuso: é horário de Brasília\nconst pd = purchase.PaymentDate;\nconst dataCompra = new Date(pd ? (/(z|[+-]\\d\\d:?\\d\\d)$/i.test(pd) ? pd : pd + '-03:00') : Date.now());\n// O Método vale 1 ano a partir da compra (o banco do Método calcula igual)\nconst acessoAte = new Date(dataCompra);\nacessoAte.setFullYear(acessoAte.getFullYear() + 1);\n\nconst nome = String(buyer.Name || '').trim();\nconst primeiro = (nome.split(' ')[0] || '').toLowerCase();\nreturn [{\n  json: {\n    acao,\n    evento,\n    status_bloqueio: BLOQUEAR[evento] || null,\n    email,\n    nome,\n    primeiro_nome: primeiro ? primeiro.charAt(0).toUpperCase() + primeiro.slice(1) : '',\n    telefone: String(buyer.PhoneNumber || '').replace(/\\D/g, ''),\n    pedido: purchase.PaymentId || '',\n    data_compra: dataCompra.toISOString(),\n    acesso_ate: acessoAte.toISOString(),\n    acesso_ate_br: acessoAte.toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }),\n    oferta: (data.Offer && data.Offer.Name) || '',\n    produtos,\n    valor: purchase.Price && purchase.Price.Value != null ? purchase.Price.Value : '',\n    teste: body.IsTest ? 'Sim' : 'Não',\n    supabase_url: SUPABASE_URL,\n  },\n}];"
      },
