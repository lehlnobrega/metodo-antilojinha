    {
      "parameters": {
        "jsCode": "const d = $('Conferir e preparar').first().json;\nlet resultado = 'ignorado';\ntry { resultado = $('Liberar no Método').first().json.resultado || resultado; } catch (e) {}\ntry { resultado = $('Bloquear no Método').first().json.resultado || resultado; } catch (e) {}\nconst TEXTOS = {\n  nova: 'Acesso liberado (aluna nova) + WhatsApp',\n  renovada: 'Acesso renovado por 1 ano + WhatsApp',\n  sem_login: 'ERRO: o login não foi criado',\n  bloqueada: 'Acesso bloqueado no Método e no Margem Certa (' + (d.status_bloqueio || '') + ')',\n  nao_encontrada: 'Reembolso de alguém que não está no app',\n  ignorado: 'Evento ignorado',\n};\nreturn [{\n  json: {\n    'Data': new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }),\n    'Evento': d.evento,\n    'Nome': d.nome,\n    'E-mail': d.email,\n    'WhatsApp': d.telefone,\n    'Produto': d.produtos,\n    'Oferta': d.oferta,\n    'Valor': d.valor,\n    'Pedido': d.pedido,\n    'Resultado': TEXTOS[resultado] || resultado,\n    'E-mail de acesso': d.acao === 'liberar' ? 'Primeiro acesso pelo WhatsApp' : '',\n    'Teste': d.teste,\n  },\n}];"
      },
