      "credentials": {
        "supabaseApi": {
          "id": "Q6CMvB8onJaGg8LC",
          "name": "Margem Certa Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Fecha só se o Margem Certa dela ainda está ativo e não tem plano próprio indo mais longe que o Método (+3 dias)\nconst saida = [];\nconst alunas = $('Quem venceu').all();\n$input.all().forEach((item, i) => {\n  const u = item.json || {};\n  if (!u.email || u.status !== 'active') return;\n  const a = alunas.find((x) => x.json.email === String(u.email).toLowerCase()) ;\n  if (!a) return;\n  const limite = new Date(a.json.acesso_ate);\n  limite.setDate(limite.getDate() + 3);\n  if (u.expires_at && new Date(u.expires_at) > limite) return;\n  saida.push({ json: { email: u.email } });\n});\nreturn saida;"
      },
