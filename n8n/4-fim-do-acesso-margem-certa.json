    {
      "parameters": {
        "jsCode": "// Alunas do Método com o acesso vencido (o app do Método já bloqueia sozinho pela data)\nreturn $input.all()\n  .filter((i) => i.json && i.json.email)\n  .map((i) => ({ json: { email: String(i.json.email).toLowerCase().trim(), acesso_ate: i.json.acesso_ate } }));"
