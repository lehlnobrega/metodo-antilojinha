    {
      "parameters": {
        "jsCode": "const data = $input.first().json.body.Data;\nconst email = (data.Buyer.Email || '').toLowerCase().trim();\nconst nome = (data.Buyer.Name || '').trim();\nconst primeiro = (nome.split(' ')[0] || '').toLowerCase();\n// Método vale 1 ano. O Margem Certa vai até a mesma data.\nconst expira = new Date();\nexpira.setFullYear(expira.getFullYear() + 1);\nreturn [{\n  json: {\n    email,\n    nome,\n    primeiro_nome: primeiro.charAt(0).toUpperCase() + primeiro.slice(1),\n    telefone: (data.Buyer.PhoneNumber || '').replace(/\\D/g, ''),\n    pedido: data.Purchase?.PaymentId || '',\n    expires_at: expira.toISOString(),\n    acesso_ate: expira.toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }),\n  },\n}];"
      },
