      "parameters": {
        "jsCode": "const data = $input.first().json.body.Data;\nconst email = (data.Buyer.Email || '').toLowerCase().trim();\nconst ev = $input.first().json.body.Event;\nconst status = ev === 'Product_access_ended' ? 'expirada' : ev === 'Payment_Chargeback' ? 'cancelada' : 'reembolsada';\nreturn [{ json: { email, status } }];"
