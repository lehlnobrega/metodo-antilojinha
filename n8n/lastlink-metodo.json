    {
      "parameters": {
        "jsCode": "const data = $input.first().json.body.Data;\nconst email = (data.Buyer.Email || '').toLowerCase().trim();\nconst nome = (data.Buyer.Name || '').trim();\nconst telefone = (data.Buyer.PhoneNumber || '').replace(/\\D/g, '');\nconst pedido = data.Purchase?.PaymentId || '';\nreturn [{\n  json: {\n    email,\n    nome,\n    primeiro_nome: nome.split(' ')[0] || '',\n    telefone,\n    pedido_lastlink: pedido,\n    data_compra: new Date().toISOString(),\n    status: 'ativa'\n  }\n}];"
      },
