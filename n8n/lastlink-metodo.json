    {
      "parameters": {
        "jsCode": "const data = $input.first().json.body.Data;\nconst email = (data.Buyer.Email || '').toLowerCase().trim();\nconst nome = (data.Buyer.Name || '').trim();\nconst primeiro = (nome.split(' ')[0] || '').toLowerCase();\n// O Método vale 1 ano a partir da compra (o banco calcula a data sozinho)\nconst ate = new Date();\nate.setFullYear(ate.getFullYear() + 1);\nreturn [{\n  json: {\n    email,\n    nome,\n    primeiro_nome: primeiro.charAt(0).toUpperCase() + primeiro.slice(1),\n    telefone: (data.Buyer.PhoneNumber || '').replace(/\\D/g, ''),\n    pedido: data.Purchase?.PaymentId || '',\n    acesso_ate: ate.toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }),\n  },\n}];"
      },
      "name": "Preparar dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        224
      ],
      "id": "96b7d330-33fc-492d-a648-0d54ede8a241"
    },
